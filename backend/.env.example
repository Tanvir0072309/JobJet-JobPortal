# Server
PORT=5000
NODE_ENV=development

# Database (local Postgres for now; swap to Render URL later, key stays the same)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobjet

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Used to encrypt per-user API keys (Groq/Hunter) at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_this_with_a_64_char_hex_string

# CORS - comma separated list of allowed origins for the frontend
CORS_ORIGIN=http://localhost:8081

# Gmail OAuth (Web application client from Google Cloud Console - the one
# with a client secret, used for the server-side authorization-code
# exchange). The Android OAuth client you already created is not used by
# this flow (see README/implementation notes) - keep it for future native
# Google Sign-In use if you want, but nothing here reads it.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_web_client_secret
# Must be added under that Web client's "Authorized redirect URIs" in
# Google Cloud Console, exactly as written here (no trailing slash).
# Local dev example: http://localhost:5000/api/gmail/oauth/callback
# Production (Render) example: https://jobjet-jobportal.onrender.com/api/gmail/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/oauth/callback

# Deep link the backend sends the in-app browser to once Gmail OAuth
# finishes, to hand control back to the Expo app. Uses the app's existing
# "jobjet" URI scheme (app.json) - only change this if you ever change that.
GMAIL_OAUTH_APP_REDIRECT=jobjet://gmail-callback

# Server-side daily cap on outbound application emails per user.
DAILY_EMAIL_LIMIT_PER_USER=100
