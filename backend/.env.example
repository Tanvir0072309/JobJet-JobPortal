# Server
PORT=5000
NODE_ENV=development

# Database (local Postgres for now; swap to Render URL later, key stays the same)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobjet

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Used to encrypt per-user API keys (Groq/Hunter) at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_this_with_a_64_char_hex_string

# CORS - comma separated list of allowed origins for the frontend
CORS_ORIGIN=http://localhost:8081
